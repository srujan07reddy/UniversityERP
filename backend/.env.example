# Application Settings
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
LOG_FORMAT=text
PROJECT_NAME="Jeppiaar University ERP"
VERSION="0.1.0"
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-64-character-secret

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=erp_secure_password_123
POSTGRES_DB=university_erp
DATABASE_URL=postgresql+asyncpg://erp_app:erp_secure_password_123@localhost:5434/university_erp

# Cache & Broker
VALKEY_HOST=localhost
VALKEY_PORT=6379
REDIS_URL=redis://localhost:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","https://localhost:5173","http://localhost:3000"]

