# ==============================================================================
# University ERP - Environment Variables Configuration
# ==============================================================================

# Application & Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
LOG_FORMAT=text
PROJECT_NAME="Jeppiaar University ERP"
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-64-character-secret

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=erp_secure_password_123
POSTGRES_DB=university_erp
DATABASE_URL=postgresql+asyncpg://erp_app:erp_secure_password_123@localhost:5434/university_erp

# Valkey / Redis (Cache & Message Broker)
VALKEY_HOST=localhost
VALKEY_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Celery Background Tasks
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security & Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS & Frontend
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","https://localhost:5173","http://localhost"]

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
